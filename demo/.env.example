# Map in Boot Demo 환경변수 설정 예시
# 실제 사용 시 이 파일을 .env로 복사하거나 상위 디렉터리 .env에 값을 설정하세요.

# 서비스 포트 바인딩
MAIN_PORT=8080
IDENTITY_PORT=8081
ACCOUNT_PORT=8082

# Docker Compose 프로젝트명
COMPOSE_PROJECT_NAME=mapinboot-demo

# 브라우저에서 접근하는 Main Origin 목록
DEMO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Demo 공통 테스트 비밀번호 (실행 시 원하는 비밀번호를 입력하세요)
DEMO_TEST_PASSWORD=

